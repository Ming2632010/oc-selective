# Neon PostgreSQL connection string
# Prefer the pooled connection (host contains `-pooler`) for serverless / Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# JWT signing secret (use a long random string in production)
JWT_SECRET=replace-with-a-long-random-secret

# OpenAI scoring
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Public base URL used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (one-off $99 AUD payment per subject; we grant 1 year of access)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Per-subject Stripe Price IDs — one-time prices, NOT recurring.
# Promotion codes are entered on the Stripe Checkout page (allow_promotion_codes).
STRIPE_WRITING_PRICE_ID=price_...
STRIPE_MATH_PRICE_ID=price_...
STRIPE_THINKING_PRICE_ID=price_...
STRIPE_READING_PRICE_ID=price_...

# Resend (payment-failure reminder emails). Optional: without it, reminders are logged.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=OC-Selective <onboarding@resend.dev>
